---
import { getImage } from 'astro:assets';
import ogImage from '../assets/images/og.png';
import { locales } from '../i18n';
import type { Dictionary, Locale } from '../i18n/types';
import { localeMeta, pageUrl } from '../i18n/urls';
import '../styles/global.css';

interface Props {
  locale: Locale;
  t: Dictionary['meta'];
}

const { locale, t } = Astro.props;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'png' });
const ogUrl = new URL(og.src, Astro.site).href;
const canonical = pageUrl(locale);
---

<!doctype html>
<html lang={localeMeta[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={localeMeta[l].lang} href={pageUrl(l)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={pageUrl('en')} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
