---
import problem from '../assets/images/problem.png';
import type { Dictionary } from '../i18n/types';
import Illustration from './Illustration.astro';

interface Props {
  t: Dictionary['problem'];
}

const { t } = Astro.props;
---

<section id="problem">
  <div class="split">
    <Illustration
      src={problem}
      alt={t.imageAlt}
      ratio="3 / 2"
      sizes="(min-width: 48rem) 28rem, 100vw"
    />
    <div>
      <h2>{t.title}</h2>
      <ul>
        {
          t.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    margin-bottom: 1.5rem;
  }
  h3 {
    margin-bottom: 0.25rem;
  }
  p {
    color: var(--graphite);
    margin: 0;
  }
</style>
