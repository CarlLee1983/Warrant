---
import problem from '../assets/images/problem.png';
import type { Dictionary } from '../i18n/types';
import Illustration from './Illustration.astro';

interface Props {
  t: Dictionary['problem'];
}

const { t } = Astro.props;
---

<section id="problem">
  <div class="split">
    <Illustration
      src={problem}
      alt={t.imageAlt}
      ratio="3 / 2"
      sizes="(min-width: 76rem) 32rem, (min-width: 60rem) 44vw, 90vw"
    />
    <div>
      <h2>{t.title}</h2>
      <ul>
        {
          t.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  h3 {
    margin-bottom: 0.5rem;
  }
  p {
    color: var(--graphite);
    margin: 0;
  }
</style>
