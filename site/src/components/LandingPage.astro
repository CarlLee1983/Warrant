---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dictionaries } from '../i18n';
import type { Locale } from '../i18n/types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Adopt from './Adopt.astro';
import Flow from './Flow.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import Rules from './Rules.astro';
import Why from './Why.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale];
---

<BaseLayout locale={locale} t={t.meta}>
  <LanguageSwitcher current={locale} label={t.languageSwitcher.label} />
  <main>
    <Hero t={t.hero} />
    <Problem t={t.problem} />
    <Rules t={t.rules} />
    <Flow t={t.flow} />
    <Adopt t={t.adopt} />
    <Why t={t.why} />
  </main>
  <Footer t={t.footer} />
</BaseLayout>
