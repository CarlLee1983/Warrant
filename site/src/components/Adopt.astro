---
import type { Dictionary } from '../i18n/types';

interface Props {
  t: Dictionary['adopt'];
}

const { t } = Astro.props;
const [install, paste] = t.steps;
---

<section id="adopt">
  <h2>{t.title}</h2>
  <ol>
    <li>
      <h3>{install.title}</h3>
      <p>{install.body}</p>
    </li>
    <li>
      <h3>{paste.title}</h3>
      <p>{paste.body}</p>
      <p class="links">
        <a class="mono" href={paste.link.href}>{paste.link.label}</a>
        <a href={paste.otherAgents.href}>{paste.otherAgents.label}</a>
      </p>
    </li>
  </ol>
  <p><a class="btn" href={t.guide.href}>{t.guide.label}</a></p>
</section>

<style>
  ol {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    counter-reset: step;
    max-width: 40rem;
  }
  li {
    counter-increment: step;
    padding-left: 3rem;
    position: relative;
  }
  li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    width: 2rem;
    height: 2rem;
    color: var(--accent);
    font: 500 1.125rem/2rem var(--mono);
    text-align: left;
  }
  h3 {
    margin-bottom: 0.25rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  @media (min-width: 60rem) {
    section {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 0 4rem;
    }
    h2 {
      grid-column: 1;
      grid-row: 1;
    }
    ol {
      grid-column: 2;
      grid-row: 1 / 3;
      margin: 0;
      gap: 2.5rem;
    }
    section > p {
      grid-column: 1;
      align-self: start;
      margin-top: 0.5rem;
    }
  }
</style>
